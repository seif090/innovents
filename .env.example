# ==============================================================================
# INOVENT Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://innovent_user:innovent_secure_pass_2026@localhost:5432/innovent_db?schema=public

# Redis Configuration (Cache, BullMQ, Socket.IO)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_ACCESS_SECRET=innovent_dev_access_jwt_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=innovent_dev_refresh_jwt_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password & OTP Policies
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Email Delivery (SMTP / Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="INOVENT Platform <noreply@innovent.app>"

# S3-Compatible Storage (MinIO in local dev, S3/R2 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=innovent-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Stripe Payment Integration (Sprint 9)
STRIPE_SECRET_KEY=sk_test_placeholder_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_development
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_for_development

# OAuth Providers (Optional in MVP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Logging & Observability
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# Sprint 5: Notifications, Push & Outbox
PUSH_PROVIDER=mock
FCM_SERVER_KEY=
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=5000
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_ENCRYPTION_KEY=innovent_dev_token_encryption_key_min_32_chars!

