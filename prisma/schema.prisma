// ==============================================================================
// INOVENT Database Schema — Sprint 2: Identity & Authentication
// PostgreSQL 16 + Prisma ORM
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Account Status & Global System Enums
// ------------------------------------------------------------------------------

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_VERIFICATION

  @@map("otp_purpose")
}

// ------------------------------------------------------------------------------
// Identity & RBAC Foundation
// ------------------------------------------------------------------------------

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  phone           String?       @db.VarChar(30)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  status          AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?     @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Explicit Relations
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  otpChallenges           OtpChallenge[]
  ownedEvents             Event[]               @relation("OwnedEvents")
  assignedOrganizerEvents EventOrganizer[]      @relation("AssignedOrganizerEvents")
  eventRegistrations      EventRegistration[]
  sessionSchedules        UserSessionSchedule[]
  sessionNotes            UserSessionNote[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   @db.VarChar(100) // e.g. "create", "read", "update", "delete", "manage"
  resource    String   @db.VarChar(100) // e.g. "event", "user", "rfq", "community"
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  rolePermissions RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// Authentication: Refresh Tokens & Sessions
// ------------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  familyId          String    @map("family_id") @db.Uuid
  jti               String    @db.VarChar(255)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------------------------
// Authentication: OTP Verification Challenges
// ------------------------------------------------------------------------------

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @map("user_id") @db.Uuid
  identifier  String     @db.VarChar(255)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(255)
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz(6)
  resendAfter DateTime   @map("resend_after") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@index([userId])
  @@index([expiresAt])
  @@map("otp_challenges")
}

// ------------------------------------------------------------------------------
// Observability: Immutable Audit Logging
// ------------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  metadata     Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// Resilience: Transactional Outbox Pattern
// ------------------------------------------------------------------------------

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// ------------------------------------------------------------------------------
// Sprint 3: Events, Agenda, Sessions, Speakers, Venues & Registrations
// ------------------------------------------------------------------------------

enum EventType {
  CONFERENCE
  EXHIBITION
  SUMMIT
  WORKSHOP
  FESTIVAL
  NETWORKING

  @@map("event_type")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED

  @@map("event_status")
}

enum EventVisibility {
  PUBLIC
  PRIVATE

  @@map("event_visibility")
}

enum TicketType {
  FREE
  PAID
  MULTI_TIER

  @@map("ticket_type")
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW

  @@map("registration_status")
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED

  @@map("session_status")
}

model Event {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @map("owner_id") @db.Uuid
  name              String          @db.VarChar(255)
  type              EventType
  shortDescription  String          @map("short_description") @db.VarChar(200)
  description       String          @db.VarChar(2000)
  startsAt          DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime        @map("ends_at") @db.Timestamptz(6)
  venueName         String          @map("venue_name") @db.VarChar(255)
  address           String          @db.VarChar(255)
  city              String          @db.VarChar(100)
  country           String          @db.VarChar(100)
  capacity          Int             @default(0)
  coverImageUrl     String          @map("cover_image_url") @db.VarChar(500)
  logoUrl           String          @map("logo_url") @db.VarChar(500)
  mainVideoUrl      String          @map("main_video_url") @db.VarChar(500)
  tags              String[]        @default([])
  officialLanguages String[]        @default([]) @map("official_languages")
  visibility        EventVisibility @default(PUBLIC)
  ticketType        TicketType      @default(FREE) @map("ticket_type")
  websiteUrl        String?         @map("website_url") @db.VarChar(500)
  isHybrid          Boolean         @default(false) @map("is_hybrid")
  status            EventStatus     @default(DRAFT)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner             User            @relation("OwnedEvents", fields: [ownerId], references: [id], onDelete: Cascade)
  organizers        EventOrganizer[]
  registrations     EventRegistration[]
  venues            Venue[]
  speakers          Speaker[]
  sessions          Session[]

  @@index([ownerId])
  @@index([status])
  @@index([visibility])
  @@index([startsAt])
  @@index([city])
  @@index([country])
  @@index([type])
  @@index([deletedAt])
  @@map("events")
}

model EventOrganizer {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User     @relation("AssignedOrganizerEvents", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_organizers")
}

model EventRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @map("event_id") @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt  DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("event_registrations")
}

model Venue {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(500)
  capacity    Int?
  floor       String?   @db.VarChar(50)
  location    String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@index([eventId])
  @@map("venues")
}

model Speaker {
  id          String           @id @default(uuid()) @db.Uuid
  eventId     String           @map("event_id") @db.Uuid
  fullName    String           @map("full_name") @db.VarChar(255)
  jobTitle    String           @map("job_title") @db.VarChar(255)
  company     String           @db.VarChar(255)
  bio         String?          @db.VarChar(2000)
  photoUrl    String?          @map("photo_url") @db.VarChar(500)
  linkedinUrl String?          @map("linkedin_url") @db.VarChar(500)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions    SessionSpeaker[]

  @@index([eventId])
  @@map("speakers")
}

model Session {
  id           String                @id @default(uuid()) @db.Uuid
  eventId      String                @map("event_id") @db.Uuid
  venueId      String?               @map("venue_id") @db.Uuid
  title        String                @db.VarChar(255)
  description  String?               @db.VarChar(2000)
  startsAt     DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime              @map("ends_at") @db.Timestamptz(6)
  displayOrder Int                   @default(0) @map("display_order")
  status       SessionStatus         @default(SCHEDULED)
  deletedAt    DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue        Venue?                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  speakers     SessionSpeaker[]
  schedules    UserSessionSchedule[]
  notes        UserSessionNote[]

  @@index([eventId])
  @@index([venueId])
  @@index([startsAt])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("sessions")
}

model SessionSpeaker {
  id           String   @id @default(uuid()) @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  speakerId    String   @map("speaker_id") @db.Uuid
  displayOrder Int      @default(0) @map("display_order")

  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker      Speaker  @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, speakerId])
  @@index([sessionId])
  @@index([speakerId])
  @@map("session_speakers")
}

model UserSessionSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@map("user_session_schedules")
}

model UserSessionNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
  @@map("user_session_notes")
}

