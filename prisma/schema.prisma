model VendorService {
  id               String       @id @default(uuid()) @db.Uuid
  vendorId         String       @map("vendor_id") @db.Uuid
  name             String       @db.VarChar(200)
  description      String       @db.Text
  category         String       @db.VarChar(100)
  pricingModel     PricingModel @default(FIXED) @map("pricing_model")
  price            Decimal      @default(0) @db.Decimal(12, 2)
  currency         String       @default("SAR") @db.VarChar(3)
  deliveryDuration String       @map("delivery_duration") @db.VarChar(100)
  serviceAreas     String[]     @default([]) @map("service_areas")
  tags             String[]     @default([])
  minimumOrder     Int          @default(1) @map("minimum_order")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(6)

  vendor           User         @relation("VendorServices", fields: [vendorId], references: [id], onDelete: Cascade)
  rfqItems         RfqItem[]

  @@index([vendorId, isActive])
  @@index([category, isActive])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("vendor_services")
}

model Rfq {
  id                 String             @id @default(uuid()) @db.Uuid
  sponsorId          String             @map("sponsor_id") @db.Uuid
  vendorId           String             @map("vendor_id") @db.Uuid
  eventId            String?            @map("event_id") @db.Uuid
  title              String             @db.VarChar(200)
  description        String             @db.Text
  requirements       String?            @db.Text
  status             RfqStatus          @default(DRAFT)
  expiresAt          DateTime           @map("expires_at") @db.Timestamptz(6)
  sentAt             DateTime?          @map("sent_at") @db.Timestamptz(6)
  viewedAt           DateTime?          @map("viewed_at") @db.Timestamptz(6)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  acceptedAt         DateTime?          @map("accepted_at") @db.Timestamptz(6)
  rejectedAt         DateTime?          @map("rejected_at") @db.Timestamptz(6)
  cancellationReason String?            @map("cancellation_reason") @db.Text
  rejectionReason    String?            @map("rejection_reason") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  sponsor            User               @relation("SentRfqs", fields: [sponsorId], references: [id], onDelete: Cascade)
  vendor             User               @relation("ReceivedRfqs", fields: [vendorId], references: [id], onDelete: Cascade)
  event              Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  items              RfqItem[]
  clarifications     RfqClarification[]
  quotations         Quotation[]

  @@index([sponsorId, createdAt])
  @@index([vendorId, status, createdAt])
  @@index([status, expiresAt])
  @@map("rfqs")
}

model RfqItem {
  id              String         @id @default(uuid()) @db.Uuid
  rfqId           String         @map("rfq_id") @db.Uuid
  vendorServiceId String?        @map("vendor_service_id") @db.Uuid
  description     String         @db.Text
  quantity        Int            @default(1)
  unit            String?        @db.VarChar(50)
  targetPrice     Decimal?       @map("target_price") @db.Decimal(12, 2)
  notes           String?        @db.Text
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  rfq             Rfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorService   VendorService? @relation(fields: [vendorServiceId], references: [id], onDelete: SetNull)
  quotationItems  QuotationItem[]

  @@index([rfqId])
  @@map("rfq_items")
}

model RfqClarification {
  id        String   @id @default(uuid()) @db.Uuid
  rfqId     String   @map("rfq_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([rfqId, createdAt])
  @@map("rfq_clarifications")
}

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  rfqId           String          @map("rfq_id") @db.Uuid
  vendorId        String          @map("vendor_id") @db.Uuid
  version         Int             @default(1)
  status          QuotationStatus @default(PENDING)
  subtotal        Decimal         @db.Decimal(12, 2)
  tax             Decimal         @default(0) @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  currency        String          @default("SAR") @db.VarChar(3)
  validUntil      DateTime        @map("valid_until") @db.Timestamptz(6)
  notes           String?         @db.Text
  acceptedAt      DateTime?       @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?       @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?         @map("rejection_reason") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  rfq             Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor          User            @relation("VendorQuotations", fields: [vendorId], references: [id], onDelete: Cascade)
  items           QuotationItem[]

  @@unique([rfqId, version])
  @@index([rfqId, status])
  @@index([vendorId, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @map("quotation_id") @db.Uuid
  rfqItemId   String?   @map("rfq_item_id") @db.Uuid
  description String    @db.Text
  quantity    Int       @default(1)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)
  notes       String?   @db.Text

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem     RfqItem?  @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

// ------------------------------------------------------------------------------
// Sprint 8: C2B Marketplace, Provider Services, Coupons & Sponsor Ads
// ------------------------------------------------------------------------------

enum C2bServiceCategory {
  ACCOMMODATION
  TRANSPORTATION
  RESTAURANTS
  COUPONS
  TRAVEL_SERVICES
  OTHER

  @@map("c2b_service_category")
}

enum C2bBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED

  @@map("c2b_booking_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum SponsorAdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  PAUSED
  EXPIRED

  @@map("sponsor_ad_status")
}

enum SponsorAdPlacement {
  MARKETPLACE
  EVENT_PAGE
  BANNER_TOP
  SIDEBAR

  @@map("sponsor_ad_placement")
}

model C2bService {
  id                  String             @id @default(uuid()) @db.Uuid
  providerId          String             @map("provider_id") @db.Uuid
  eventId             String             @map("event_id") @db.Uuid
  name                String             @db.VarChar(200)
  category            C2bServiceCategory @default(OTHER)
  shortDescription    String             @map("short_description") @db.VarChar(300)
  detailedDescription String             @map("detailed_description") @db.Text
  images              String[]           @default([])
  price               Decimal?           @db.Decimal(12, 2)
  discountPercentage  Int?               @map("discount_percentage")
  currency            String             @default("SAR") @db.VarChar(3)
  expiresAt           DateTime           @map("expires_at") @db.Timestamptz(6)
  contactMethod       String             @map("contact_method") @db.VarChar(50)
  contactValue        String?            @map("contact_value") @db.VarChar(255)
  promotionalCode     String?            @map("promotional_code") @db.VarChar(50)
  maxBookings         Int?               @map("max_bookings")
  bookingCount        Int                @default(0) @map("booking_count")
  isAvailable         Boolean            @default(true) @map("is_available")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  provider            User               @relation("ProviderC2bServices", fields: [providerId], references: [id], onDelete: Cascade)
  event               Event              @relation("EventC2bServices", fields: [eventId], references: [id], onDelete: Cascade)
  bookings            C2bBooking[]
  coupons             Coupon[]

  @@index([providerId, isAvailable])
  @@index([eventId, category, isAvailable])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("c2b_services")
}

model C2bBooking {
  id            String           @id @default(uuid()) @db.Uuid
  serviceId     String           @map("service_id") @db.Uuid
  attendeeId    String           @map("attendee_id") @db.Uuid
  providerId    String           @map("provider_id") @db.Uuid
  eventId       String           @map("event_id") @db.Uuid
  status        C2bBookingStatus @default(PENDING)
  notes         String?          @db.Text
  providerNotes String?          @map("provider_notes") @db.Text
  contactMethod String?          @map("contact_method") @db.VarChar(50)
  contactValue  String?          @map("contact_value") @db.VarChar(255)
  requestedDate DateTime?        @map("requested_date") @db.Timestamptz(6)
  confirmedAt   DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt   DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  service       C2bService       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  attendee      User             @relation("AttendeeC2bBookings", fields: [attendeeId], references: [id], onDelete: Cascade)
  provider      User             @relation("ProviderReceivedC2bBookings", fields: [providerId], references: [id], onDelete: Cascade)
  event         Event            @relation("EventC2bBookings", fields: [eventId], references: [id], onDelete: Cascade)

  @@index([attendeeId, createdAt])
  @@index([providerId, status, createdAt])
  @@index([serviceId, status])
  @@map("c2b_bookings")
}

model Coupon {
  id              String           @id @default(uuid()) @db.Uuid
  providerId      String           @map("provider_id") @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  serviceId       String?          @map("service_id") @db.Uuid
  code            String           @db.VarChar(50)
  normalizedCode  String           @unique @map("normalized_code") @db.VarChar(50)
  description     String?          @db.Text
  discountType    DiscountType     @default(PERCENTAGE) @map("discount_type")
  discountValue   Decimal          @map("discount_value") @db.Decimal(10, 2)
  maxRedemptions  Int?             @map("max_redemptions")
  redemptionCount Int              @default(0) @map("redemption_count")
  startsAt        DateTime?        @map("starts_at") @db.Timestamptz(6)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(6)

  provider        User             @relation("ProviderCoupons", fields: [providerId], references: [id], onDelete: Cascade)
  event           Event            @relation("EventCoupons", fields: [eventId], references: [id], onDelete: Cascade)
  service         C2bService?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  redemptions     CouponRedemption[]

  @@index([providerId, isActive])
  @@index([eventId, isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  attendeeId     String   @map("attendee_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  serviceId      String?  @map("service_id") @db.Uuid
  discountAmount Decimal? @map("discount_amount") @db.Decimal(10, 2)
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(128)
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  attendee       User     @relation("AttendeeCouponRedemptions", fields: [attendeeId], references: [id], onDelete: Cascade)
  event          Event    @relation("EventCouponRedemptions", fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([couponId, attendeeId])
  @@index([attendeeId, redeemedAt])
  @@map("coupon_redemptions")
}

model SponsorAd {
  id               String             @id @default(uuid()) @db.Uuid
  sponsorId        String             @map("sponsor_id") @db.Uuid
  eventId          String?            @map("event_id") @db.Uuid
  title            String             @db.VarChar(200)
  description      String             @db.Text
  imageUrl         String             @map("image_url") @db.VarChar(500)
  destinationUrl   String             @map("destination_url") @db.VarChar(500)
  placement        SponsorAdPlacement @default(MARKETPLACE)
  status           SponsorAdStatus    @default(DRAFT)
  rejectionReason  String?            @map("rejection_reason") @db.Text
  reviewedByUserId String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  startsAt         DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime           @map("ends_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(6)

  sponsor          User               @relation("SponsorAds", fields: [sponsorId], references: [id], onDelete: Cascade)
  event            Event?             @relation("EventSponsorAds", fields: [eventId], references: [id], onDelete: SetNull)
  reviewedByUser   User?              @relation("ReviewedSponsorAds", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([sponsorId, status, createdAt])
  @@index([status, startsAt, endsAt])
  @@index([eventId, status])
  @@index([deletedAt])
  @@map("sponsor_ads")
}

// ==============================================================================
// SPRINT 9: STRIPE PAYMENTS, SPONSORED COMMUNITIES & SUBSCRIPTIONS
// ==============================================================================

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentPurpose {
  COMMUNITY_SPONSORSHIP
  SUBSCRIPTION

  @@map("payment_purpose")
}

enum CommunitySponsorshipStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REFUNDED

  @@map("community_sponsorship_status")
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
  TRIALING

  @@map("subscription_status")
}

enum SubscriptionPlan {
  SPONSOR_MONTHLY
  SPONSOR_ANNUAL
  VENDOR_MONTHLY
  VENDOR_ANNUAL

  @@map("subscription_plan")
}

enum SubscriptionBillingInterval {
  MONTH
  YEAR

  @@map("subscription_billing_interval")
}

enum StripeWebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED

  @@map("stripe_webhook_status")
}

model CommunitySponsorshipPlan {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique @db.VarChar(50)
  name           String                 @db.VarChar(100)
  description    String?                @db.VarChar(500)
  price          Decimal                @db.Decimal(12, 2)
  currency       String                 @default("SAR") @db.VarChar(3)
  memberCapacity Int                    @default(500) @map("member_capacity")
  durationDays   Int                    @default(30) @map("duration_days")
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  sponsorships   CommunitySponsorship[]

  @@map("community_sponsorship_plans")
}

model CommunitySponsorship {
  id                      String                     @id @default(uuid()) @db.Uuid
  communityId             String                     @map("community_id") @db.Uuid
  sponsorId               String                     @map("sponsor_id") @db.Uuid
  userId                  String                     @map("user_id") @db.Uuid
  planId                  String                     @map("plan_id") @db.Uuid
  paymentId               String?                    @unique @map("payment_id") @db.Uuid
  status                  CommunitySponsorshipStatus @default(PENDING_PAYMENT)
  amount                  Decimal                    @db.Decimal(12, 2)
  currency                String                     @default("SAR") @db.VarChar(3)
  sponsoredCapacity       Int                        @map("sponsored_capacity")
  startsAt                DateTime?                  @map("starts_at") @db.Timestamptz(6)
  endsAt                  DateTime?                  @map("ends_at") @db.Timestamptz(6)
  stripeCheckoutSessionId String?                    @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  community               Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  sponsor                 SponsorProfile             @relation("SponsorSponsorships", fields: [sponsorId], references: [id], onDelete: Cascade)
  user                    User                       @relation("UserSponsorships", fields: [userId], references: [id], onDelete: Cascade)
  plan                    CommunitySponsorshipPlan   @relation(fields: [planId], references: [id])
  payment                 Payment?                   @relation(fields: [paymentId], references: [id])

  @@index([communityId])
  @@index([sponsorId])
  @@index([userId])
  @@index([status])
  @@index([endsAt])
  @@map("community_sponsorships")
}

model SubscriptionPlanConfig {
  id            String                      @id @default(uuid()) @db.Uuid
  plan          SubscriptionPlan            @unique
  name          String                      @db.VarChar(100)
  description   String?                     @db.VarChar(500)
  targetRole    String                      @map("target_role") @db.VarChar(50)
  stripePriceId String?                     @map("stripe_price_id") @db.VarChar(100)
  price         Decimal                     @db.Decimal(12, 2)
  currency      String                      @default("SAR") @db.VarChar(3)
  interval      SubscriptionBillingInterval @default(MONTH)
  isActive      Boolean                     @default(true) @map("is_active")
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("subscription_plan_configs")
}

model Subscription {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String                      @map("user_id") @db.Uuid
  sponsorProfileId     String?                     @map("sponsor_profile_id") @db.Uuid
  vendorProfileId      String?                     @map("vendor_profile_id") @db.Uuid
  planConfigId         String                      @map("plan_config_id") @db.Uuid
  plan                 SubscriptionPlan
  status               SubscriptionStatus          @default(INCOMPLETE)
  amount               Decimal                     @db.Decimal(12, 2)
  currency             String                      @default("SAR") @db.VarChar(3)
  interval             SubscriptionBillingInterval @default(MONTH)
  stripeCustomerId     String                      @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId String                      @unique @map("stripe_subscription_id") @db.VarChar(100)
  currentPeriodStart   DateTime?                   @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd     DateTime?                   @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean                     @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?                   @map("canceled_at") @db.Timestamptz(6)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                        @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  sponsorProfile       SponsorProfile?             @relation("SponsorSubscriptions", fields: [sponsorProfileId], references: [id], onDelete: SetNull)
  vendorProfile        VendorProfile?              @relation("VendorSubscriptions", fields: [vendorProfileId], references: [id], onDelete: SetNull)
  planConfig           SubscriptionPlanConfig      @relation(fields: [planConfigId], references: [id])
  payments             Payment[]

  @@index([userId])
  @@index([sponsorProfileId])
  @@index([vendorProfileId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model Payment {
  id                      String                @id @default(uuid()) @db.Uuid
  userId                  String                @map("user_id") @db.Uuid
  sponsorProfileId        String?               @map("sponsor_profile_id") @db.Uuid
  vendorProfileId         String?               @map("vendor_profile_id") @db.Uuid
  subscriptionId          String?               @map("subscription_id") @db.Uuid
  amount                  Decimal               @db.Decimal(12, 2)
  currency                String                @default("SAR") @db.VarChar(3)
  status                  PaymentStatus         @default(PENDING)
  purpose                 PaymentPurpose
  provider                String                @default("stripe") @db.VarChar(50)
  stripePaymentIntentId   String?               @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeCheckoutSessionId String?               @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripeInvoiceId         String?               @map("stripe_invoice_id") @db.VarChar(255)
  idempotencyKey          String?               @unique @map("idempotency_key") @db.VarChar(255)
  metadata                Json?
  paidAt                  DateTime?             @map("paid_at") @db.Timestamptz(6)
  failedAt                DateTime?             @map("failed_at") @db.Timestamptz(6)
  refundedAt              DateTime?             @map("refunded_at") @db.Timestamptz(6)
  refundAmount            Decimal?              @map("refund_amount") @db.Decimal(12, 2)
  refundReason            String?               @map("refund_reason") @db.VarChar(500)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                    User                  @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  sponsorProfile          SponsorProfile?       @relation("SponsorPayments", fields: [sponsorProfileId], references: [id], onDelete: SetNull)
  vendorProfile           VendorProfile?        @relation("VendorPayments", fields: [vendorProfileId], references: [id], onDelete: SetNull)
  subscription            Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  communitySponsorship    CommunitySponsorship?

  @@index([userId])
  @@index([sponsorProfileId])
  @@index([vendorProfileId])
  @@index([status])
  @@index([purpose])
  @@index([createdAt])
  @@map("payments")
}

model StripeWebhookEvent {
  id               String              @id @default(uuid()) @db.Uuid
  provider         String              @default("stripe") @db.VarChar(50)
  providerEventId  String              @unique @map("provider_event_id") @db.VarChar(255)
  eventType        String              @map("event_type") @db.VarChar(100)
  processingStatus StripeWebhookStatus @default(PENDING) @map("processing_status")
  processedAt      DateTime?           @map("processed_at") @db.Timestamptz(6)
  failureReason    String?             @map("failure_reason") @db.VarChar(1000)
  payload          Json?
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([providerEventId])
  @@index([processingStatus])
  @@map("stripe_webhook_events")
}

// ------------------------------------------------------------------------------
// Sprint 10: Content Moderation & Reporting System
// ------------------------------------------------------------------------------

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum ReportTargetType {
  COMMUNITY_POST
  COMMUNITY_REPLY
  COMMUNITY_MEETUP
  COMMUNITY_CHAT_MESSAGE
  EVENT
  COMMUNITY
  SPONSOR_AD
  C2B_SERVICE
  VENDOR_SERVICE
  USER

  @@map("report_target_type")
}

model Report {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String           @map("reporter_id") @db.Uuid
  targetType       ReportTargetType @map("target_type")
  targetId         String           @map("target_id") @db.Uuid
  reason           String           @db.VarChar(100)
  description      String?          @db.VarChar(1000)
  status           ReportStatus     @default(OPEN)
  resolvedByUserId String?          @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolutionNote   String?          @map("resolution_note") @db.VarChar(1000)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter         User             @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy       User?            @relation("ResolvedReports", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

